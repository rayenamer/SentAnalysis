# Reference only: this service reads process environment, not .env files.
INGESTION_SOURCES=[{"name":"finance","url":"https://feeds.example/finance.xml"}]
INGESTION_TIMEOUT_SECONDS=10
INGESTION_MAX_RESPONSE_BYTES=2000000
INGESTION_MAX_DOCUMENTS=100
INGESTION_MAX_ENTRIES_PER_SOURCE=200
INGESTION_COMPANY_TICKERS={"Apple Inc.":"AAPL","Microsoft":"MSFT"}

# Providers are opt-in: request providers explicitly in POST /ingest/run.
INGESTION_NEWSAPI_ENABLED=true
INGESTION_NEWSAPI_API_KEY=a120e9a341bd43e7b1dfbc9d9839485a
INGESTION_NEWSAPI_KEYWORDS=["earnings","financial markets"]
INGESTION_NEWSAPI_TICKERS=["AAPL","MSFT","TSLA"]
INGESTION_NEWSAPI_LANGUAGE=en
INGESTION_NEWSAPI_MAX_RECORDS=50
INGESTION_NEWSAPI_TIMEOUT_SECONDS=10

# GDELT needs no API key. DOC artlist returns titles, not article bodies.
INGESTION_GDELT_ENABLED=true
INGESTION_GDELT_KEYWORDS=["earnings","financial markets"]
INGESTION_GDELT_TICKERS=["AAPL","MSFT","TSLA"]
INGESTION_GDELT_TIMESPAN=24h
INGESTION_GDELT_MAX_RECORDS=50
INGESTION_GDELT_TIMEOUT_SECONDS=10


# Twelve Data: explicit provider symbols; index access depends on entitlement.
INGESTION_MARKET_ENABLED=true
INGESTION_MARKET_API_KEY=f7fec0f9eb794be7863838ce00e287d4
INGESTION_MARKET_INSTRUMENTS=[{"ticker":"AAPL","provider_symbol":"AAPL","asset_type":"stock"},{"ticker":"MSFT","provider_symbol":"MSFT","asset_type":"stock"},{"ticker":"TSLA","provider_symbol":"TSLA","asset_type":"stock"},{"ticker":"BTC","provider_symbol":"BTC/USD","asset_type":"crypto"},{"ticker":"ETH","provider_symbol":"ETH/USD","asset_type":"crypto"},{"ticker":"SPY","provider_symbol":"SPY","asset_type":"etf"},{"ticker":"SPX","provider_symbol":"SPX","asset_type":"index"}]
INGESTION_MARKET_INTERVAL=1h
INGESTION_MARKET_OUTPUTSIZE=100
INGESTION_MARKET_TIMEOUT_SECONDS=10

# Insight must expose the full factory app: app.main:create_app --factory.
# These variables are read from process environment, not automatically from .env.
INSIGHT_SERVICE_URL=http://127.0.0.1:8000
INSIGHT_REQUEST_TIMEOUT_SECONDS=15
INSIGHT_MAX_RETRIES=1
INSIGHT_RETRY_BACKOFF_SECONDS=0.25
INSIGHT_MAX_RESPONSE_BYTES=2000000

# Scheduling is disabled by default. One owner per checkout/host via OS lock;
# use only one scheduler-enabled replica across different hosts/containers.
INGESTION_SCHEDULER_ENABLED=true
INGESTION_SCHEDULER_PROVIDERS=["rss","newsapi","gdelt","market"]
INGESTION_SCHEDULER_RSS_INTERVAL_SECONDS=300
INGESTION_SCHEDULER_NEWSAPI_INTERVAL_SECONDS=900
INGESTION_SCHEDULER_GDELT_INTERVAL_SECONDS=900
INGESTION_SCHEDULER_MARKET_INTERVAL_SECONDS=900
INGESTION_SCHEDULER_ANALYZE_DOCUMENTS=false
INGESTION_SCHEDULER_ANALYSIS_MODEL=vader
INGESTION_SCHEDULER_ANALYSIS_CHUNK_SIZE=4
INGESTION_SCHEDULER_SHUTDOWN_TIMEOUT_SECONDS=5

# Public Hacker News Algolia API: no credentials required; disabled by default.
# Search each keyword separately; global record/byte limits still apply.
INGESTION_HACKERNEWS_ENABLED=true
INGESTION_HACKERNEWS_KEYWORDS=["Apple","Microsoft","Tesla","Nvidia","Bitcoin"]
INGESTION_HACKERNEWS_HITS_PER_PAGE=10
INGESTION_HACKERNEWS_MAX_PAGES=1
INGESTION_HACKERNEWS_MAX_RECORDS=50
INGESTION_HACKERNEWS_TIMEOUT_SECONDS=10
# Optional: include "hackernews" in INGESTION_SCHEDULER_PROVIDERS to schedule it.
INGESTION_SCHEDULER_HACKERNEWS_INTERVAL_SECONDS=900
