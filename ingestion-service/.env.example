# Reference only: this service reads process environment, not .env files.
INGESTION_SOURCES=[{"name":"finance","url":"https://feeds.example/finance.xml"}]
INGESTION_TIMEOUT_SECONDS=10
INGESTION_MAX_RESPONSE_BYTES=2000000
INGESTION_MAX_DOCUMENTS=100
INGESTION_MAX_ENTRIES_PER_SOURCE=200
INGESTION_COMPANY_TICKERS={"Apple Inc.":"AAPL","Microsoft":"MSFT"}

# Providers are opt-in: request providers explicitly in POST /ingest/run.
INGESTION_NEWSAPI_ENABLED=false
INGESTION_NEWSAPI_API_KEY=replace_with_newsapi_key
INGESTION_NEWSAPI_KEYWORDS=["earnings","financial markets"]
INGESTION_NEWSAPI_TICKERS=["AAPL","MSFT","TSLA"]
INGESTION_NEWSAPI_LANGUAGE=en
INGESTION_NEWSAPI_MAX_RECORDS=50
INGESTION_NEWSAPI_TIMEOUT_SECONDS=10

# GDELT needs no API key. DOC artlist returns titles, not article bodies.
INGESTION_GDELT_ENABLED=false
INGESTION_GDELT_KEYWORDS=["earnings","financial markets"]
INGESTION_GDELT_TICKERS=["AAPL","MSFT","TSLA"]
INGESTION_GDELT_TIMESPAN=24h
INGESTION_GDELT_MAX_RECORDS=50
INGESTION_GDELT_TIMEOUT_SECONDS=10

# Requires an approved confidential Reddit Data API application.
INGESTION_REDDIT_ENABLED=false
INGESTION_REDDIT_CLIENT_ID=replace_with_reddit_client_id
INGESTION_REDDIT_CLIENT_SECRET=replace_with_reddit_client_secret
INGESTION_REDDIT_USER_AGENT=SentAnalysis/0.2 by replace_with_operator_name
INGESTION_REDDIT_SUBREDDITS=["stocks","investing","wallstreetbets","cryptocurrency"]
INGESTION_REDDIT_PAGE_SIZE=25
INGESTION_REDDIT_MAX_PAGES=2
INGESTION_REDDIT_TIMEOUT_SECONDS=10

# Twelve Data: explicit provider symbols; index access depends on entitlement.
INGESTION_MARKET_ENABLED=false
INGESTION_MARKET_API_KEY=replace_with_twelvedata_key
INGESTION_MARKET_INSTRUMENTS=[{"ticker":"AAPL","provider_symbol":"AAPL","asset_type":"stock"},{"ticker":"MSFT","provider_symbol":"MSFT","asset_type":"stock"},{"ticker":"TSLA","provider_symbol":"TSLA","asset_type":"stock"},{"ticker":"BTC","provider_symbol":"BTC/USD","asset_type":"crypto"},{"ticker":"ETH","provider_symbol":"ETH/USD","asset_type":"crypto"},{"ticker":"SPY","provider_symbol":"SPY","asset_type":"etf"},{"ticker":"SPX","provider_symbol":"SPX","asset_type":"index"}]
INGESTION_MARKET_INTERVAL=1h
INGESTION_MARKET_OUTPUTSIZE=100
INGESTION_MARKET_TIMEOUT_SECONDS=10
